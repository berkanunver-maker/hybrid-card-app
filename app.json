{
  "expo": {
    "name": "hybrid-card-app",
    "slug": "hybrid-card-app",
    "version": "1.0.0",
    "main": "App.js",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hybridcardapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beko.hybridcard"
    },
    "android": {
      "package": "com.beko.hybridcard",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kartvizit görsellerini seçmek için galeri erişimi gerekir.",
          "cameraPermission": "Kartvizit taramak için kamera erişimi gerekir."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kartları telefon rehberinize kaydetmek için kişiler erişimi gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "76e59f8c-35f8-4600-b934-f9ce99affa4f"
      }
    }
  }
}
